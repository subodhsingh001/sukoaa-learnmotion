# Copy to .env and CHANGE every value. Never commit .env.
DATABASE_URL=postgresql+psycopg://sukoaa:CHANGE_ME@localhost:5432/sukoaa
JWT_SECRET=generate-with-python-c-"import secrets;print(secrets.token_hex(32))"
